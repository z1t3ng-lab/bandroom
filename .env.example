HOST=127.0.0.1
PORT=8000
BAND_DB=data/band.sqlite3
# Leave blank for local SQLite. For hosting, use a private PostgreSQL URL from your database provider.
BAND_DATABASE_URL=
COOKIE_SECURE=0
BAND_LOG=1
# Optional SMTP settings for password resets and rehearsal notifications.
# Use credentials from your email delivery provider; never commit real values.
BANDROOM_PUBLIC_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Bandroom
